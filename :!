#include <regex>
#include <fstream>
#include <iostream>
#include <string>

#ifndef DATA_DIR
#error "DATA_DIR must be defined by CMake. Use cmake to build this project."
#endif

const std::string DATA = DATA_DIR;

int main()
{
    std::ifstream in(DATA + "Regex_stud.txt");
    if (!in) std::cerr << "Can not open file" << std::endl;

    std::regex header{R"(^[\w ]+( [\w ]+)*$)"};  // header line
    std::regex row {R"(^[\w ]+( \d+)( \d+)( \d+)$)"}; // data line
    
    std::string line;
    int linenum = 0;

    if(std::getline(in, line)){
        std::smatch match;
        if(!std::regex_match(line, match, header)){
            std::cerr << "Header line is not valid" << std::endl;
            return 1;
        }
    }
    
    int boycnt = 0;
    int girlcnt = 0;

    while (std::getline(in, line)) {
        ++linenum;

        std::smatch match;
        if(!std::regex_match(line, match, row)){
            std::cerr << "Data line " << linenum + 1 << " is not valid" << std::endl;
            return 1;
        }
        
        int boyrow = std::stoi(match[2].str());
        int grilrow = std::stoi(match[3].str());
        int total = std::stoi(match[4].str());
        
        if(total != boyrow + grilrow){
            std::cerr << "Data line " << linenum + 1 << " is not valid: total does not match" << std::endl;
            return 1;
        }

        if (match[1] == "Alle klasser") {
            if(boycnt != boyrow) {
                std::cerr << "boys don't add up\n" << std::endl;
                return 1;
            } 
            if (girlcnt != grilrow) {
                std::cerr << "girls don't add up\n" << std::endl;
                return 1;
            }
            
            if (!(in >> std::ws).eof()) {
                std::cerr << "Data line " << linenum + 1 << " is not valid: extra data after Alle klasser" << std::endl;
            }
            
            return 0;
        }
        boycnt += boyrow;
        girlcnt += boyrow;
    }

    std::cerr << "didn't find total line" << std::endl;

    return 0;
}
